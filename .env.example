# Local / Docker Compose environment
# Copy to .env.docker for compose, or .env for local Vite dev

# --- Vite build-time (baked into the static bundle) ---
VITE_GAME_NAME=Wordle 2.1
VITE_GAME_DESCRIPTION=Wordle auf Deutsch

# --- Local compose (host port publish) ---
WORDLE_PORT=8080

# Optional
# COMPOSE_PROJECT_NAME=wordle
# IMAGE_TAG=latest
