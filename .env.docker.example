# Docker Compose Environment Variables
# Copy this file to .env.docker and adjust values as needed
#
# Local (host port):
#   docker compose --env-file .env.docker -f docker-compose.prod.yml up -d --build

# Vite build args (passed into the Docker image build)
VITE_GAME_NAME=Wordle
VITE_GAME_DESCRIPTION=Wordle auf Deutsch

# Local-only host port mapping
WORDLE_PORT=8080

# Leaderboard API — shared secret entered once per device in the app; anyone
# who knows it can participate under any name. Required for the leaderboard-api
# service to start; pick your own value.
LEADERBOARD_PASSPHRASE=change-me

# Optional
# COMPOSE_PROJECT_NAME=wordle
# IMAGE_TAG=latest
