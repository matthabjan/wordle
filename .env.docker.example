# Docker Compose Environment Variables
# Copy this file to .env.docker and adjust values as needed
#
# Local (host port):
#   docker compose --env-file .env.docker -f docker-compose.prod.yml up -d --build
#
# Traefik (no host port):
#   docker compose --env-file .env.docker \
#     -f docker-compose.prod.yml -f docker-compose.traefik.yml up -d --build

# Vite build args (passed into the Docker image build)
VITE_GAME_NAME=Wordle 2.1
VITE_GAME_DESCRIPTION=Wordle auf Deutsch

# Local-only host port mapping (ignored when using the Traefik overlay)
WORDLE_PORT=8080

# Traefik public hostname (required when using docker-compose.traefik.yml)
WORDLE_HOST=wordle.example.com

# Optional
# COMPOSE_PROJECT_NAME=wordle
# IMAGE_TAG=latest
