# Docker Compose Environment Variables
# Copy this file to .env.docker and adjust values as needed
# Usage: docker-compose --env-file .env.docker -f docker-compose.prod.yml up -d

# Port mapping for the Wordle application
# The app will be accessible at http://localhost:WORDLE_PORT
WORDLE_PORT=8080

# Docker image tag (optional, for versioning)
# IMAGE_TAG=latest

# Network configuration (optional)
# COMPOSE_PROJECT_NAME=wordle
